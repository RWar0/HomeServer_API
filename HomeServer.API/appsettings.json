{
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Policies": {
      "Login": {
        "KeyType": "Ip",
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6
      },
      "Refresh": {
        "KeyType": "User",
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6
      },
      "Register": {
        "KeyType": "Ip",
        "PermitLimit": 2,
        "WindowSeconds": 3600,
        "SegmentsPerWindow": 6
      },
      "Upload": {
        "KeyType": "User",
        "PermitLimit": 20,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6
      }
    }
  },
  "ConnectionStrings": {
    "DatabaseConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HomeServer;Integrated security=true;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Access": {
      "DurationInMinutes": 45
    },
    "Refresh": {
      "DurationInMinutes": 10080
    },
    "Issuer": "HomeServerAPI",
    "Audience": "HomeServerUsers"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
